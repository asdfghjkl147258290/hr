<%- include('../layout', { title: '管理后台', body: (function(){ %>
  <h2>管理后台</h2>
  <p><a href="/admin/new">新建职位</a> · <a href="/admin/logout">登出</a></p>
  <% if (!jobs || !jobs.length) { %>
    <p>当前没有职位。</p>
  <% } else { %>
    <table class="jobs-table">
      <thead><tr><th>ID</th><th>标题</th><th>地点</th><th>发布时间</th><th>操作</th></tr></thead>
      <tbody>
        <% jobs.forEach(function(job){ %>
          <tr>
            <td><%= job.id %></td>
            <td><%= job.title %></td>
            <td><%= job.location %></td>
            <td><%= new Date(job.posted_at).toLocaleString() %></td>
            <td>
              <a href="/admin/jobs/<%= job.id %>/edit">编辑</a>
              <form method="post" action="/admin/jobs/<%= job.id %>?_method=DELETE" style="display:inline">
                <button type="submit" onclick="return confirm('确定删除？')">删除</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
<% })() }) %>
